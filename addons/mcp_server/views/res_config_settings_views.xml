<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mcp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mcp</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block"
                     string="MCP Server"
                     data-string="MCP Server"
                     data-key="mcp_server"
                     groups="mcp_server.group_mcp_admin">

                    <h2>Protocol &amp; Transport</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="mcp_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="mcp_enabled"/>
                                <div class="text-muted">
                                    Master switch for the /mcp endpoint.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="mcp_require_resource_indicator"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="mcp_require_resource_indicator"/>
                                <div class="text-muted">
                                    Reject access tokens not bound to this MCP resource (RFC 8707).
                                </div>
                            </div>
                        </div>
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="mcp_server_url" string="Public Base URL"/>
                                <div class="text-muted">
                                    External HTTPS URL of this Odoo as seen by clients. Used for
                                    OAuth metadata and RFC 8707 audience validation.
                                </div>
                                <div class="content-group mt16">
                                    <field name="mcp_server_url" placeholder="https://erp.example.com"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h2>OAuth</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="mcp_dcr_open"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="mcp_dcr_open" string="Open Dynamic Client Registration"/>
                                <div class="text-muted">
                                    Allow clients (e.g. Claude) to self-register via /mcp/oauth/register.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="mcp_access_token_ttl" string="Access Token TTL (s)"/>
                                <div class="content-group mt16">
                                    <field name="mcp_access_token_ttl"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="mcp_refresh_token_ttl" string="Refresh Token TTL (s)"/>
                                <div class="content-group mt16">
                                    <field name="mcp_refresh_token_ttl"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h2>Safety &amp; Audit</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="mcp_enable_alerts"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="mcp_enable_alerts" string="Alert on Sensitive Actions"/>
                                <div class="text-muted">
                                    Schedule an activity for MCP admins on sensitive tool calls.
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="mcp_confirmation_ttl" string="Confirmation Token TTL (s)"/>
                                <div class="text-muted">
                                    Lifetime of propose/confirm tokens for write tools.
                                </div>
                                <div class="content-group mt16">
                                    <field name="mcp_confirmation_ttl"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="mcp_report_link_ttl" string="Report Link TTL (s)"/>
                                <div class="text-muted">
                                    Lifetime of tokenized PDF report download links.
                                </div>
                                <div class="content-group mt16">
                                    <field name="mcp_report_link_ttl"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="mcp_sensitive_categories" string="Sensitive Categories"/>
                                <div class="content-group mt16">
                                    <field name="mcp_sensitive_categories"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="mcp_sensitive_tool_prefixes" string="Sensitive Tool Prefixes"/>
                                <div class="content-group mt16">
                                    <field name="mcp_sensitive_tool_prefixes"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_mcp_config_settings" model="ir.actions.act_window">
        <field name="name">MCP Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'mcp_server'}</field>
    </record>
</odoo>
